{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "rotate:payout-encryption": "pnpm run build && node --enable-source-maps ./dist/rotate-payout-encryption.mjs",
    "test:payout-encryption": "node --experimental-strip-types --test ./tests/payout-encryption.test.mjs",
    "test:payout-security": "node --experimental-strip-types --test ./tests/payout-security.test.mjs",
    "test:executive-access": "node --experimental-strip-types --test ./tests/executive-access.test.mjs",
    "test:property-photo-exif": "node --experimental-strip-types --test ./tests/property-photo-exif.test.mjs",
    "test:property-photo-cleanup": "node --experimental-strip-types --test ./tests/property-photo-cleanup.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "piexifjs": "^1.0.6",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
